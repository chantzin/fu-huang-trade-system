{
  "name": "mingjhong-trading-system",
  "version": "1.0.40",
  "description": "輔凰商貿 — 貿易訂單暨應收應付管理系統（Node.js + Express + SQLite + 原生 SPA）。硬規則：工號 emp_id 識別、auth.provider 預留 HR 串接、獨立可安裝、四副本部署。",
  "main": "dist-server/server.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node dist-server/server.js",
    "dev": "vite",
    "build": "vite build",
    "predeploy": "node scripts/release-gate.mjs",
    "deploy": "node scripts/deploy-safe.mjs --skip-gate",
    "git:backup": "node scripts/git-sync.mjs",
    "smoke": "node tests/smoke.mjs",
    "test:api": "node tests/api-write-smoke.mjs",
    "test:backup-restore": "node tests/backup-restore-smoke.mjs",
    "test:failover": "node tests/db-failover-smoke.mjs",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:backup": "node scripts/backup-db.mjs",
    "db:backup:mysql": "node scripts/backup-mysql-live.mjs",
    "pdf:verify": "node scripts/verify-doc-fingerprint.mjs",
    "healthcheck": "node tests/_healthcheck-mj.cjs && node tests/_healthcheck-api.cjs && node tests/_healthcheck-backup.cjs",
    "healthcheck:full": "npm run healthcheck && node tests/_healthcheck-referentials.cjs && node tests/_healthcheck-deep.cjs && node tests/_healthcheck-config.cjs && node tests/_healthcheck-restore.cjs",
    "fix:receivables-customer": "node scripts/fix-receivables-customer.cjs",
    "start:prod": "node scripts/start-mj.mjs",
    "start:watch": "node scripts/start-mj.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "ts:drift": "node scripts/ts-drift.mjs",
    "ts:drift:ci": "node scripts/ts-drift.mjs --fail-under 95",
    "build:single": "node scripts/set-edition.mjs single && npm run build",
    "build:network": "node scripts/set-edition.mjs network && npm run build",
    "edition:set": "node scripts/set-edition.mjs"
  },
  "dependencies": {
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/extension-text-align": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^1.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "preact": "^10.29.8",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}